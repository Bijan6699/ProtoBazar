name: Build Windows app

on:
  workflow_dispatch:
  push:
    tags:
      - "v*"

jobs:
  build:
    runs-on: windows-latest
    steps:
      - name: Check out source
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt pyinstaller

      - name: Build application
        shell: cmd
        run: |
          python -m PyInstaller --noconfirm --clean --onedir --name ProtoBazar ^
            --collect-all streamlit ^
            --collect-all plotly ^
            --collect-all pandas ^
            --collect-all numpy ^
            --collect-all openpyxl ^
            --collect-all xlrd ^
            --collect-all defusedxml ^
            --add-data "dashboard.py;." ^
            --add-data "pricing_module.py;." ^
            --add-data "sales_analytics_module.py;." ^
            --add-data "logo.png;." ^
            launcher.py
          copy /Y RUN_PROTOBAZAR.bat dist\RUN_PROTOBAZAR.bat

      - name: Package Windows folder
        shell: pwsh
        run: Compress-Archive -Path dist\ProtoBazar,dist\RUN_PROTOBAZAR.bat -DestinationPath ProtoBazar-Windows.zip

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: ProtoBazar-Windows
          path: ProtoBazar-Windows.zip
